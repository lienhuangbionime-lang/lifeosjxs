generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}


model LogEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   String   @db.Text
  mood      Int?
  focus     Int?
  energy    Int?
  vtrRatio  Float?   
  habits    Json?    
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("ACTIVE")
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id         String    @id @default(cuid())
  title      String
  context    String?
  status     String    @default("PENDING")
  dueDate    DateTime?
  isUrgent   Boolean   @default(false)
  
  logEntryId String
  logEntry   LogEntry  @relation(fields: [logEntryId], references: [id])
  
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  
  createdAt  DateTime  @default(now())
}

// [NEW] 月度復盤與戰略 (CCA Core)
model MonthlyReview {
  id        String   @id @default(cuid())
  month     String   @unique // 格式: "2024-01"
  
  // 報告內容 (Markdown)
  content   String   @db.Text 
  
  // 核心指標 (從報告中萃取)
  vtr       Float?   // Value-Time Ratio
  fScore    Int?     // Family Score
  
  // 下月戰略 (JSON 儲存 STOP/START/PROTECT)
  strategy  Json?    
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}