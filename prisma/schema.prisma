// 檔案位置: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model LogEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   String   @db.Text
  
  // 核心指標
  mood      Int?
  focus     Int?
  energy    Int?
  vtrRatio  Float?   
  
  // 習慣追蹤
  habits    Json?    
  
  // [New] AI 身份驗證欄位 (這就是你要的功能)
  aiModel   String?  @default("manual") // 紀錄模型，如 "gemini-1.5-flash"
  isAi      Boolean  @default(false)    // 是否為 AI 生成
  
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ... (Project, Task, MonthlyReview 維持不變，請保留它們)
model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  status    String   @default("ACTIVE")
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id         String    @id @default(cuid())
  title      String
  context    String?
  status     String    @default("PENDING")
  dueDate    DateTime?
  isUrgent   Boolean   @default(false)
  logEntryId String
  logEntry   LogEntry  @relation(fields: [logEntryId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  createdAt  DateTime  @default(now())
}

model MonthlyReview {
  id        String   @id @default(cuid())
  month     String   @unique
  content   String   @db.Text 
  vtr       Float?
  fScore    Int?
  strategy  Json?    
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}