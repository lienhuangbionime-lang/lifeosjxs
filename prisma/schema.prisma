// 這是產生器設定 (保留我們之前的相容性修正)
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

// 這是資料庫設定 (只能有一個！請確保只有這一段)
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // 用於連線池 (Connection Pool)
  directUrl = env("POSTGRES_URL_NON_POOLING") // 用於 Migration (直接連線)
}

// 底下接你的 Models (LogEntry, Task, Project 等等...)
// 確保不要動到下面的資料表定義
model LogEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   String
  mood      Int?
  focus     Int?
  energy    Int?
  graphSeeds Json?    // 存儲 Graph 的節點資訊
  habits    Json?    // 存儲習慣打卡
  isAi      Boolean  @default(false)
  aiModel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  status      String    @default("PENDING") // PENDING, DONE, ARCHIVED
  isUrgent    Boolean   @default(false)
  dueDate     DateTime?
  context     String?   // @home, @office
  project     Project?  @relation(fields: [projectId], references: [id])
  projectId   String?
  logEntry    LogEntry? @relation(fields: [logEntryId], references: [id])
  logEntryId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}